rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read on profiles, authenticated writes only for the owner
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;

      match /likes/{postId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /reposts/{postId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Username reservations: allow create if not exists, require auth
    match /username-reservations/{username} {
      allow read: if true;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/username-reservations/$(username));
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Posts, comments, replies, likes, and reposts
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.likes == resource.data.get('likes', 0) + 1 ||
        request.resource.data.likes == resource.data.get('likes', 0) - 1 ||
        request.resource.data.reposts == resource.data.get('reposts', 0) + 1 ||
        request.resource.data.reposts == resource.data.get('reposts', 0) - 1 ||
        request.resource.data.bookmarks == resource.data.get('bookmarks', 0) + 1 ||
        request.resource.data.bookmarks == resource.data.get('bookmarks', 0) - 1 ||
        request.resource.data.comments == resource.data.get('comments', 0) + 1 ||
        request.resource.data.comments == resource.data.get('comments', 0) - 1
      );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.likes == resource.data.get('likes', 0) + 1 ||
          request.resource.data.likes == resource.data.get('likes', 0) - 1 ||
          request.resource.data.reposts == resource.data.get('reposts', 0) + 1 ||
          request.resource.data.reposts == resource.data.get('reposts', 0) - 1 ||
          request.resource.data.bookmarks == resource.data.get('bookmarks', 0) + 1 ||
          request.resource.data.bookmarks == resource.data.get('bookmarks', 0) - 1 ||
          request.resource.data.comments == resource.data.get('comments', 0) + 1 ||
          request.resource.data.comments == resource.data.get('comments', 0) - 1
        );
        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
        }

        match /likes/{userId} {
          allow read: if true;
          allow create, delete: if request.auth != null && request.auth.uid == userId;
        }

        match /reposts/{userId} {
          allow read: if true;
          allow create, delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /reposts/{userId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bookmarks: owner-only access
    match /bookmarks/{bookmarkId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid) && (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    // Follows: follower-owned write access, public read
    match /follows/{followId} {
      allow read: if true;
      allow create, delete: if request.auth != null && (request.resource == null || request.resource.data.followerUid == request.auth.uid) && (resource == null || resource.data.followerUid == request.auth.uid);
    }

    // Notifications: owner-owned read/update, authenticated creation
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && (resource.data.recipientId == request.auth.uid || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && (request.resource.data.recipientId != null || request.resource.data.uid != null);
    }

    // Conversations: members-only access
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.userIds;
        allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      }
    }

    // Subscriptions for new post notifications
    match /subscriptions/{subscriptionId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.followerUid == request.auth.uid) && (request.resource == null || request.resource.data.followerUid == request.auth.uid);
    }

    // Activities: authenticated creation for matching uid
    match /activities/{activityId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Feature notifications (launch notifications)
    match /feature_notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Fallback: allow reads, deny writes by default
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
