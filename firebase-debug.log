[debug] [2026-07-30T10:11:02.342Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/vibeztube-dev-bc81c/rulesets {"name":"projects/vibeztube-dev-bc81c/rulesets/6f60b481-51a5-4332-a71a-7e47762012e8","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Public read on profiles, authenticated writes only for the owner\r\n    match /profiles/{userId} {\r\n      allow read: if true;\r\n      allow create, update: if request.auth != null && request.auth.uid == userId;\r\n\r\n      match /likes/{postId} {\r\n        allow read: if true;\r\n        allow write: if request.auth != null && request.auth.uid == userId;\r\n      }\r\n      match /reposts/{postId} {\r\n        allow read: if true;\r\n        allow write: if request.auth != null && request.auth.uid == userId;\r\n      }\r\n      match /replies/{replyId} {\r\n        allow read: if true;\r\n        allow write: if request.auth != null && request.auth.uid == userId;\r\n      }\r\n    }\r\n\r\n    // Username reservations: allow create if not exists, require auth\r\n    match /username-reservations/{username} {\r\n      allow read: if true;\r\n      allow create: if request.auth != null && !exists(/databases/$(database)/documents/username-reservations/$(username));\r\n      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;\r\n    }\r\n\r\n    // Posts, comments, replies, likes, and reposts\r\n    match /posts/{postId} {\r\n      allow read: if true;\r\n      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;\r\n      allow update: if request.auth != null;\r\n      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;\r\n\r\n      match /comments/{commentId} {\r\n        allow read: if true;\r\n        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;\r\n        allow update: if request.auth != null;\r\n        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;\r\n\r\n        match /replies/{replyId} {\r\n          allow read: if true;\r\n          allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;\r\n          allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;\r\n        }\r\n\r\n        match /likes/{userId} {\r\n          allow read: if true;\r\n          allow create, delete: if request.auth != null && request.auth.uid == userId;\r\n        }\r\n\r\n        match /reposts/{userId} {\r\n          allow read: if true;\r\n          allow create, delete: if request.auth != null && request.auth.uid == userId;\r\n        }\r\n      }\r\n\r\n      match /likes/{userId} {\r\n        allow read: if true;\r\n        allow create, delete: if request.auth != null && request.auth.uid == userId;\r\n      }\r\n\r\n      match /reposts/{userId} {\r\n        allow read: if true;\r\n        allow create, delete: if request.auth != null && request.auth.uid == userId;\r\n      }\r\n    }\r\n\r\n    // Bookmarks: owner-only access\r\n    match /bookmarks/{bookmarkId} {\r\n      allow read, write: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid) && (request.resource == null || request.resource.data.uid == request.auth.uid);\r\n    }\r\n\r\n    // Follows: follower-owned write access, public read\r\n    match /follows/{followId} {\r\n      allow read: if true;\r\n      allow create, delete: if request.auth != null && (request.resource == null || request.resource.data.followerUid == request.auth.uid) && (resource == null || resource.data.followerUid == request.auth.uid);\r\n    }\r\n\r\n    // Notifications: owner-owned read/update, authenticated creation\r\n    match /notifications/{notificationId} {\r\n      allow read, update: if request.auth != null && (resource.data.recipientId == request.auth.uid || resource.data.uid == request.auth.uid);\r\n      allow create: if request.auth != null && (request.resource.data.recipientId != null || request.resource.data.uid != null);\r\n    }\r\n\r\n    // Conversations: members-only access\r\n    match /conversations/{conversationId} {\r\n      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;\r\n      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds;\r\n      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;\r\n\r\n      match /messages/{messageId} {\r\n        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.userIds;\r\n        allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;\r\n      }\r\n    }\r\n\r\n    // Subscriptions for new post notifications\r\n    match /subscriptions/{subscriptionId} {\r\n      allow read, write: if request.auth != null && (resource == null || resource.data.followerUid == request.auth.uid) && (request.resource == null || request.resource.data.followerUid == request.auth.uid);\r\n    }\r\n\r\n    // Activities: authenticated creation for matching uid\r\n    match /activities/{activityId} {\r\n      allow read: if true;\r\n      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;\r\n    }\r\n\r\n    // Feature notifications (launch notifications)\r\n    match /feature_notifications/{notificationId} {\r\n      allow read: if request.auth != null && resource.data.userId == request.auth.uid;\r\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\r\n    }\r\n\r\n    // Fallback: allow reads, deny writes by default\r\n    match /{document=**} {\r\n      allow read: if true;\r\n      allow write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firebase/firestore.rules"}]},"createTime":"2026-07-30T10:10:57.668479Z","metadata":{"services":["cloud.firestore"]}}
